# Un-remarkable configuration (read by docker compose)

# Host port for the web UI, REST API and MCP endpoint
RMC_PORT=8099

# Sync interval in seconds (default: 2 minutes)
RMC_SYNC_INTERVAL_SECONDS=120

# Concurrency for downloading document blobs
RMC_MAX_CONCURRENT_DOWNLOADS=6

# Logging level (DEBUG, INFO, WARNING, ERROR)
RMC_LOG_LEVEL=INFO

# Vision OCR & Handwriting extraction (Google Gemini / OpenAI / Ollama)
# GEMINI_API_KEY=AIzaSy...
# VISION_PROVIDER=gemini
# VISION_MODEL=gemini-flash-lite-latest
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=http://localhost:11434
