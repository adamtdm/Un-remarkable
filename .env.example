# reMarkable Companion Configuration

# Storage directory (defaults to ./data locally, or /data in Docker)
RMC_DATA_DIR=./data

# Network port and host
RMC_HOST=0.0.0.0
RMC_PORT=8099

# Sync interval in seconds (default: 2 minutes)
RMC_SYNC_INTERVAL_SECONDS=120

# Concurrency for downloading document blobs
RMC_MAX_CONCURRENT_DOWNLOADS=6

# Logging level (DEBUG, INFO, WARNING, ERROR)
RMC_LOG_LEVEL=INFO
